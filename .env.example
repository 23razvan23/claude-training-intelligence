# Copy to .env and change every value. .env is gitignored.
POSTGRES_DB=training
POSTGRES_USER=training
POSTGRES_PASSWORD=change-me

# Bootstrap coach account, created on first start if no coach exists.
COACH_USERNAME=coach
COACH_PASSWORD=change-me-too
COACH_DISPLAY_NAME=Coach

# Passphrase for nightly encrypted database backups (openssl AES-256, PBKDF2).
BACKUP_PASSPHRASE=change-me-backup

# Web port on the host.
WEB_PORT=8080

# Garmin daily sync (stage 1b-4; ADR 0011). Leave empty until then: the app starts
# without them and only Garmin sync is disabled. Generate each one, once, with:
#   openssl rand -base64 32
# GARMIN_TOKEN_KEY: 32 random bytes (base64) that encrypt the Garmin access token in the
# database. Only the app gets it. Never store it next to the backups: if you lose or
# change it, you just connect Garmin again.
GARMIN_TOKEN_KEY=
# GARMIN_SYNC_SECRET: shared secret the app sends to the garmin-sync sidecar
# (X-Sync-Secret header); the sidecar refuses requests without it.
GARMIN_SYNC_SECRET=
