# Copy to .env and change every value. .env is gitignored.
POSTGRES_DB=training
POSTGRES_USER=training
POSTGRES_PASSWORD=change-me

# Bootstrap coach account, created on first start if no coach exists.
COACH_USERNAME=coach
COACH_PASSWORD=change-me-too
COACH_DISPLAY_NAME=Coach

# Passphrase for nightly encrypted database backups (openssl AES-256, PBKDF2).
BACKUP_PASSPHRASE=change-me-backup

# Web port on the host.
WEB_PORT=8080
